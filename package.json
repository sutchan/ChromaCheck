{
  "name": "chromacheck",
  "version": "1.17.7",
  "private": true,
  "description": "色辨 ChromaCheck — 在线色觉检测 Web 应用（Next.js 16 + TS + Tailwind）",
  "keywords": [
    "color-blindness",
    "color-vision",
    "ishihara",
    "color-vision-test",
    "d15",
    "hue-arrangement",
    "nextjs",
    "typescript",
    "tailwindcss",
    "pwa",
    "accessibility",
    "screening"
  ],
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "i18n:tw": "node scripts/generate-tw-content.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:openapi": "node scripts/check-openapi.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "20.14.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "opencc-js": "^1.0.5",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "^5.7.3",
    "vitest": "2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
